# Template of the variables this project reads. The existing .env.example may be out of date: compare, then replace it with: git mv -f env.template .env.example
# Then cp .env.example .env and fill in the values. Never commit .env.

# --- Postgres ---
# Host runs (scripts, UI on the host): 127.0.0.1 and the published port. Compose services override host and port themselves.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=market_scanner          # required: database name
POSTGRES_USER=scanner               # required: app login (not the admin)
POSTGRES_PASSWORD=change-me         # required: password for POSTGRES_USER
POSTGRES_ADMIN_USER=change-me       # required by compose: role that owns ./data/postgres
POSTGRES_ADMIN_PASSWORD=change-me   # required by compose: password for POSTGRES_ADMIN_USER
SCANNER_POSTGRES_PORT=5433          # optional: published host port for the Postgres container (default 5433)
SCANNER_POSTGRES_HOST=127.0.0.1     # optional: host used by scripts/load_upstox_5y_to_pg.py (default 127.0.0.1)
# POSTGRES_DSN=                     # beats the parts above, must agree with POSTGRES_USER and POSTGRES_DB, normally leave unset

# --- Mongo ---
SCANNER_MONGO_USER=change-me        # required: app login for the project Mongo (--auth)
SCANNER_MONGO_PASSWORD=change-me    # required: password for SCANNER_MONGO_USER
SCANNER_MONGO_HOST=127.0.0.1:27018  # host:port the host scripts connect to
SCANNER_MONGO_PORT=27018            # optional: published host port for the Mongo container (default 27018)
SCANNER_MONGO_DB=market_scanner     # optional: database name (default market_scanner)
SCANNER_MONGO_AUTH_SOURCE=market_scanner  # optional: auth database (default is the project db)

# --- Neo4j ---
NEO4J_AUTH=neo4j/change-me          # required by compose: user/password for the Neo4j container
NEO4J_URI=bolt://127.0.0.1:7688     # Bolt URI the scripts connect to
NEO4J_USER=neo4j                    # login user for NEO4J_URI
NEO4J_PASSWORD=change-me            # password for NEO4J_USER
SCANNER_NEO4J_HTTP_PORT=7475        # optional: published host port for the Neo4j browser/HTTP (default 7475)
SCANNER_NEO4J_BOLT_PORT=7688        # optional: published host port for Bolt (default 7688)

# --- Backends (leave commented out to use the defaults) ---
# MARKETDATA_BACKEND=               # unset means postgres; sqlite is for offline runs only
# DOCSTORE_BACKEND=                 # unset means mongo; tinydb is for offline runs only

# --- Brokers and market data ---
UPSTOX_ANALYTICS_ACCESS_TOKEN=      # optional: Upstox analytics token for the Upstox data pulls
KITE_API_KEY=                       # optional: Zerodha Kite API key (portfolio, auth)
KITE_API_SECRET=                    # optional: Zerodha Kite API secret (used by the login flow)
KITE_ACCESS_TOKEN=                  # optional: Kite access token for the current day

# --- LLM ---
LLM_URL=http://127.0.0.1:11434      # optional: LLM endpoint used by enrich
CONCLUDE_URL=http://127.0.0.1:11434 # optional: endpoint used by conclude (compose sets its own value)

# --- Other ---
BENCH_VLLM_IMAGE=                   # optional: container image for scripts/bench_models.py
BENCH_WEIGHTS_DIR=                  # optional: host directory holding model weights for the benchmark
LAYA_API_KEY=                       # optional: bearer key for the Laya service (empty means no auth)
LAYA_PRELOAD=                       # optional: Laya model preload setting (see docker/laya/Dockerfile)
LAYA_DEVICE=                        # optional: Laya compute device (see docker/laya/Dockerfile)

# Read by code but possibly legacy or test-only (not included): MONGO_URI, MONGO_DB, MONGO_USER, MONGO_PASSWORD, SCANNER_ENV
# Dropped (named in the spec, read by nothing in code; only mentioned in handoff.md): SCANNER_MONGO_ADMIN
