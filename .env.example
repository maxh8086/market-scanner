# Copy this file to .env and fill in real values. Do NOT put secrets here.

# Upstox long-lived analytics access token -- MARKET DATA source.
# Generate at https://account.upstox.com/developer/apps
UPSTOX_ANALYTICS_ACCESS_TOKEN=your-upstox-analytics-token-here

# Kite Connect credentials -- PORTFOLIO only.
KITE_API_KEY=your-kite-api-key-here
KITE_API_SECRET=your-kite-api-secret-here
