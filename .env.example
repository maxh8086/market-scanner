# Copy this file to .env and fill in real values. Do NOT put secrets here.

# Upstox long-lived analytics access token -- MARKET DATA source.
# Generate at https://account.upstox.com/developer/apps
UPSTOX_ANALYTICS_ACCESS_TOKEN=your-upstox-analytics-token-here

# Kite Connect credentials -- PORTFOLIO only.
KITE_API_KEY=your-kite-api-key-here
KITE_API_SECRET=your-kite-api-secret-here
KITE_ACCESS_TOKEN=

# Screener.in login -- OPTIONAL, fundamentals only.
# screener.in pages are public, and `enrich.py --fundamentals` works without
# these. Logged in, the same page fetch returns a richer payload, so the
# ratios (P/E, ROCE, promoter pledge, debt/equity) and the revenue series
# come back more completely. These are read from the environment by the
# borrowed screener_mcp client, not by this project's own code.
SCREENER_USERNAME=your-screener-email-here
SCREENER_PASSWORD=your-screener-password-here
